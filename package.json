{
  "name": "shogun-documentation-public",
  "version": "0.1.15",
  "private": true,
  "description": "Public documentation registry for Shogun.dev projects and services.",
  "scripts": {
    "start": "docusaurus start --host 0.0.0.0",
    "build": "docusaurus build",
    "serve": "node server.mjs",
    "test:security": "node --test scripts/security-headers.test.mjs",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serve-handler": "6.1.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.7.3"
  },
  "overrides": {
    "webpack": "5.113.0",
    "serialize-javascript": "^7.1.3",
    "tinypool": "^2.1.2",
    "uuid": "^11.1.1"
  },
  "resolutions": {
    "webpack": "5.113.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
